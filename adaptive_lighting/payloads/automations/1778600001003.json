{
  "alias": "Hue Tap Dial 2 - Lounge",
  "description": "B1 script.adaptive_lounge | B2 scene.lounge_galaxy | B3 toggle LR shades | B4 lounge off | dial brightness",
  "mode": "queued",
  "max": 10,
  "triggers": [
    {
      "trigger": "state",
      "entity_id": "event.hue_tap_dial_switch_3_button_1",
      "id": "btn1"
    },
    {
      "trigger": "state",
      "entity_id": "event.hue_tap_dial_switch_3_button_2",
      "id": "btn2"
    },
    {
      "trigger": "state",
      "entity_id": "event.hue_tap_dial_switch_3_button_3",
      "id": "btn3"
    },
    {
      "trigger": "state",
      "entity_id": "event.hue_tap_dial_switch_3_button_4",
      "id": "btn4"
    },
    {
      "trigger": "state",
      "entity_id": "event.hue_tap_dial_switch_3_rotary",
      "id": "dial"
    }
  ],
  "actions": [
    {
      "choose": [
        {
          "conditions": [
            {
              "condition": "trigger",
              "id": "btn1"
            },
            {
              "condition": "template",
              "value_template": "{{ trigger.to_state.attributes.event_type == 'short_release' }}"
            }
          ],
          "sequence": [
            {
              "action": "script.adaptive_lounge"
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "trigger",
              "id": "btn2"
            },
            {
              "condition": "template",
              "value_template": "{{ trigger.to_state.attributes.event_type == 'short_release' }}"
            }
          ],
          "sequence": [
            {
              "action": "scene.turn_on",
              "target": {
                "entity_id": "scene.lounge_galaxy"
              }
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "trigger",
              "id": "btn3"
            },
            {
              "condition": "template",
              "value_template": "{{ trigger.to_state.attributes.event_type == 'short_release' }}"
            }
          ],
          "sequence": [
            {
              "choose": [
                {
                  "conditions": [
                    {
                      "condition": "template",
                      "value_template": "{{ states('cover.living_room_shade_1') == 'closed' and states('cover.living_room_shade_2') == 'closed' }}"
                    }
                  ],
                  "sequence": [
                    {
                      "action": "cover.open_cover",
                      "target": {
                        "entity_id": [
                          "cover.living_room_shade_1",
                          "cover.living_room_shade_2"
                        ]
                      }
                    }
                  ]
                }
              ],
              "default": [
                {
                  "action": "cover.close_cover",
                  "target": {
                    "entity_id": [
                      "cover.living_room_shade_1",
                      "cover.living_room_shade_2"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "trigger",
              "id": "btn4"
            },
            {
              "condition": "template",
              "value_template": "{{ trigger.to_state.attributes.event_type == 'short_release' }}"
            }
          ],
          "sequence": [
            {
              "action": "light.turn_off",
              "target": {
                "entity_id": "light.lounge"
              },
              "data": {
                "transition": 0.4
              }
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "trigger",
              "id": "dial"
            }
          ],
          "sequence": [
            {
              "action": "light.turn_on",
              "target": {
                "entity_id": "light.lounge"
              },
              "data": {
                "brightness_step_pct": "{% set s = trigger.to_state.attributes.steps | int(1) %}{% set d = trigger.to_state.attributes.event_type %}{{ ((s / 4) | round(0)) | int if d == 'clock_wise' else ((-s / 4) | round(0)) | int }}",
                "transition": 0.2
              }
            }
          ]
        }
      ]
    }
  ]
}