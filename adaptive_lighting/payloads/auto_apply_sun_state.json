{
  "alias": "Auto-apply sun state to all rooms",
  "description": "Re-applies sun state for non-overridden rooms at schedule boundaries: 7am, sunrise+30, noon-30, noon+30, sunset-30, 9pm, 11pm, and weather changes",
  "mode": "single",
  "triggers": [
    {"trigger": "time", "at": "07:00:00"},
    {"trigger": "sun", "event": "sunrise", "offset": "+00:30:00"},
    {"trigger": "time", "at": "12:30:00"},
    {"trigger": "time", "at": "14:00:00"},
    {"trigger": "sun", "event": "sunset",  "offset": "-00:30:00"},
    {"trigger": "time", "at": "21:00:00"},
    {"trigger": "time", "at": "23:00:00"},
    {"trigger": "state", "entity_id": "weather.forecast_lullwood"}
  ],
  "actions": [
    {
      "repeat": {
        "for_each": ["bedroom", "guest_bathroom", "lounge", "office_j", "office_m", "primary_bathroom"],
        "sequence": [
          {
            "if": [
              {
                "condition": "template",
                "value_template": "{{ is_state('input_boolean.' ~ repeat.item ~ '_scene_override', 'off') and is_state('light.' ~ repeat.item, 'on') }}"
              }
            ],
            "then": [
              {
                "action": "script.apply_sun_state",
                "data": {"room_prefix": "{{ repeat.item }}"}
              }
            ]
          }
        ]
      }
    }
  ]
}
