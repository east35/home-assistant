{
  "alias": "Revert All Rooms to Auto",
  "description": "Clears every room's override and re-applies the current sun state",
  "sequence": [
    {
      "repeat": {
        "for_each": ["bedroom", "guest_bathroom", "lounge", "office_j", "office_m", "primary_bathroom"],
        "sequence": [
          {
            "action": "script.revert_room_to_auto",
            "data": {"room_prefix": "{{ repeat.item }}"}
          }
        ]
      }
    }
  ],
  "mode": "single"
}
