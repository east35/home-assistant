{
  "alias": "Bar Nook follows Lounge",
  "description": "Mirrors switch.bar_nook to light.lounge on/off state",
  "mode": "single",
  "triggers": [
    {"trigger": "state", "entity_id": "light.lounge", "to": "on",  "id": "on"},
    {"trigger": "state", "entity_id": "light.lounge", "to": "off", "id": "off"}
  ],
  "actions": [
    {
      "choose": [
        {
          "conditions": [{"condition": "trigger", "id": "on"}],
          "sequence": [
            {"action": "switch.turn_on",  "target": {"entity_id": "switch.bar_nook"}}
          ]
        },
        {
          "conditions": [{"condition": "trigger", "id": "off"}],
          "sequence": [
            {"action": "switch.turn_off", "target": {"entity_id": "switch.bar_nook"}}
          ]
        }
      ]
    }
  ]
}
