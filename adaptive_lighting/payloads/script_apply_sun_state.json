{
  "alias": "Apply Sun State",
  "description": "Sets brightness + color temp on light.{room_prefix} based on time-of-day schedule with sun-relative dawn/dusk/noon transitions",
  "fields": {
    "room_prefix": {"description": "Room prefix e.g. office_j"}
  },
  "sequence": [
    {
      "variables": {
        "now_ts":     "{{ as_timestamp(now()) }}",
        "is_heavy":   "{{ states('weather.forecast_lullwood') in ['rainy','pouring','lightning','lightning-rainy','fog','snowy','snowy-rainy','hail'] }}",
        "sunrise_ts": "{{ (as_timestamp(state_attr('sun.sun','next_rising')) - 86400) if states('sun.sun') == 'above_horizon' else as_timestamp(state_attr('sun.sun','next_rising')) }}",
        "sunset_ts":  "{{ as_timestamp(state_attr('sun.sun','next_setting')) if states('sun.sun') == 'above_horizon' else (as_timestamp(state_attr('sun.sun','next_setting')) - 86400) }}",
        "noon_ts":    "{{ as_timestamp(state_attr('sun.sun','next_noon')) if (as_timestamp(state_attr('sun.sun','next_noon')) - as_timestamp(now())) < 64800 else (as_timestamp(state_attr('sun.sun','next_noon')) - 86400) }}",
        "sr30":       "{{ sunrise_ts + 1800 }}",
        "ss30":       "{{ sunset_ts - 1800 }}",
        "nm30":       "{{ noon_ts - 1800 }}",
        "np30":       "{{ noon_ts + 1800 }}",
        "t7am":       "{{ as_timestamp(today_at('07:00')) }}",
        "t9pm":       "{{ as_timestamp(today_at('21:00')) }}",
        "t11pm":      "{{ as_timestamp(today_at('23:00')) }}"
      }
    },
    {
      "variables": {
        "mood": "{{ 'nightlight' if (now_ts >= t11pm or now_ts < t7am) else 'nightlight' if (room_prefix == 'lounge' and now_ts < sr30) else ('rest' if is_heavy else 'relax') if now_ts < sr30 else ('relax' if now_ts < ss30 else 'rest') if is_heavy else 'energize' if (now_ts >= nm30 and now_ts < np30) else 'cool_bright' if now_ts < ss30 else 'relax' if now_ts < t9pm else 'rest' }}",
        "brightness_pct":    "{{ {'energize':100,'cool_bright':100,'read':80,'relax':56,'rest':56,'dim':30,'nightlight':1}[mood] }}",
        "color_temp_kelvin": "{{ {'energize':6410,'cool_bright':4291,'read':2890,'relax':2237,'rest':2237,'dim':2000,'nightlight':2000}[mood] }}"
      }
    },
    {
      "action": "light.turn_on",
      "target": {"entity_id": "light.{{ room_prefix }}"},
      "data": {
        "brightness_pct":    "{{ brightness_pct | int }}",
        "color_temp_kelvin": "{{ color_temp_kelvin | int }}",
        "transition": 0.4
      }
    }
  ],
  "mode": "single"
}
