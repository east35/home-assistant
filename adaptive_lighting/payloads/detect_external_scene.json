{
  "alias": "Lock room when external scene activated",
  "description": "Sets override when a user manually activates any scene.{room}_* via Hue app, dashboard, voice, etc.",
  "mode": "queued",
  "max": 10,
  "triggers": [
    {
      "trigger": "event",
      "event_type": "call_service",
      "event_data": {
        "domain": "scene",
        "service": "turn_on"
      }
    }
  ],
  "conditions": [
    {
      "condition": "template",
      "value_template": "{{ trigger.event.context.user_id is not none }}"
    }
  ],
  "actions": [
    {
      "variables": {
        "ents": "{{ trigger.event.data.service_data.entity_id if trigger.event.data.service_data is defined else trigger.event.data.target.entity_id }}",
        "ent_list": "{{ ents if ents is iterable and ents is not string else [ents] }}",
        "rooms": ["bedroom", "guest_bathroom", "lounge", "office_j", "office_m", "primary_bathroom"]
      }
    },
    {
      "repeat": {
        "for_each": "{{ rooms }}",
        "sequence": [
          {
            "if": [
              {
                "condition": "template",
                "value_template": "{{ ent_list | select('match', '^scene\\\\.' ~ repeat.item ~ '_') | list | count > 0 }}"
              }
            ],
            "then": [
              {
                "action": "input_boolean.turn_on",
                "target": {"entity_id": "input_boolean.{{ repeat.item }}_scene_override"}
              }
            ]
          }
        ]
      }
    }
  ]
}
