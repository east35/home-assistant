{
  "alias": "iPod Dock Play/Pause → AVR CD",
  "triggers": [
    {
      "trigger": "event",
      "event_type": "broadlink_event",
      "event_data": {
        "device": "ipod_dock",
        "command": "play_pause"
      }
    }
  ],
  "conditions": [],
  "actions": [
    {
      "action": "media_player.turn_on",
      "target": { "entity_id": "media_player.vsx_lx305" }
    },
    {
      "delay": { "seconds": 2 }
    },
    {
      "action": "media_player.select_source",
      "target": { "entity_id": "media_player.vsx_lx305" },
      "data": { "source": "CD" }
    }
  ],
  "mode": "single"
}
