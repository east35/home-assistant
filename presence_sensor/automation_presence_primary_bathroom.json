{
  "alias": "Presence Garage - Light On/Off",
  "triggers": [
    {
      "id": "presence_on",
      "trigger": "state",
      "entity_id": "binary_sensor.sensor_primary_bathroom_presence",
      "to": "on"
    },
    {
      "id": "presence_off",
      "trigger": "state",
      "entity_id": "binary_sensor.sensor_primary_bathroom_presence",
      "to": "off",
      "for": {
        "seconds": 4
      }
    },
    {
      "trigger": "homeassistant",
      "event": "start"
    },
    {
      "trigger": "event",
      "event_type": "automation_reloaded"
    }
  ],
  "actions": [
    {
      "choose": [
        {
          "conditions": [
            {
              "condition": "trigger",
              "id": "presence_on"
            }
          ],
          "sequence": [
            {
              "action": "light.turn_on",
              "target": { "entity_id": "light.garage" }
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "trigger",
              "id": "presence_off"
            }
          ],
          "sequence": [
            {
              "action": "light.turn_off",
              "target": { "entity_id": "light.garage" }
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "state",
              "entity_id": "binary_sensor.sensor_primary_bathroom_presence",
              "state": "on"
            }
          ],
          "sequence": [
            {
              "action": "light.turn_on",
              "target": { "entity_id": "light.garage" }
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "state",
              "entity_id": "binary_sensor.sensor_primary_bathroom_presence",
              "state": "off"
            }
          ],
          "sequence": [
            {
              "action": "light.turn_off",
              "target": { "entity_id": "light.garage" }
            }
          ]
        }
      ]
    }
  ],
  "mode": "single"
}
